# Dockerfile for the HF Space (rename to `Dockerfile` in the Space repo).
# HF removed the native Streamlit SDK for new Spaces (only gradio/docker/static remain),
# so the demo ships as a Docker Space running Streamlit — HF's documented pattern:
# non-root user 1000, writable HOME (Streamlit config + the 440MB HF model cache land there).
FROM python:3.11-slim

RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH
WORKDIR /home/user/app

COPY --chown=user requirements.txt requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

COPY --chown=user . .

EXPOSE 8501
CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
